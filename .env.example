# 公開ポート
APP_PORT=50033

# 推測されにくい任意のキーにしてください。`local` のままでも動きますが起動時のログで警告が出ます
API_KEY='local'

# COEIROINKの接続先
COEIROINK_URL='http://host.docker.internal:50032'

# `auto`、スタイルID、または`つくよみちゃん/れいせい`のような名前を指定してください
DEFAULT_VOICE='auto'

# ブラウザー上で動くクライアントのオリジン（例: http://localhost:3000）複数はカンマ区切り
CORS_ORIGINS=''
